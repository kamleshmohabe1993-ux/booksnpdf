# Copy to .dev.vars for local `wrangler dev` (this file is gitignored).
# In production, set every one of these with `wrangler secret put NAME`
# instead of putting them in wrangler.toml.

# --- Frontend origin (for CORS) ---
# wrangler.toml's [vars] FRONTEND_URL defaults to a placeholder production
# domain, which also applies during `wrangler dev` unless overridden here.
# Astro's dev server runs on http://localhost:4321 by default — set this to
# match it, or every request from `astro dev` will fail CORS.
FRONTEND_URL=https://booksnpdf.com

# --- Database ---
# MongoDB Atlas connection string. Use the standard `mongodb+srv://` URI
# from Atlas > Connect > Drivers. Make sure Atlas Network Access allows
# 0.0.0.0/0 (Cloudflare Workers egress IPs are not static/whitelistable).
MONGODB_URI=mongodb+srv://kamleshmohabe1:ytIIbBoodUTeFAd6@cluster0.fusmo.mongodb.net/bookspdf

# --- Auth ---
JWT_SECRET=45e1805d1c244d3068820da3fa67035f

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=576878915843-a4nqhjj8th9l9hbmlg70qqqovct3t8f9.apps.googleusercontent.com

# --- Admin account (created on first request to /api/health after deploy) ---
ADMIN_PASSWORD=Kam@1993

