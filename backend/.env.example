# Copy this file to .env and fill in real values:
#   cp .env.example .env

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb://localhost:27017/bookspdf

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=7d

# --- Google Sign-In (SSO) ---
# Create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials, and add your frontend
# origin(s) (e.g. http://localhost:4321, https://bookspdf.com) under
# "Authorized JavaScript origins". No redirect URI is needed — the login
# page uses Google's One Tap/button flow and posts the ID token directly.
# NOTE: this must be the SAME client ID as the frontend's
# PUBLIC_GOOGLE_CLIENT_ID (frontend-astro/.env), or token verification
# will fail. Leaving this unset simply disables the Google button.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Admin account (auto-created on first server start) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# --- Frontend URL (used for links generated in emails, CORS, etc.) ---
FRONTEND_URL=http://localhost:4321

# --- Email (Resend — https://resend.com) ---
# Used for OTP / password-reset emails (see services/emailService.js).
EMAIL_USER=onboarding@resend.dev
RESEND_API_KEY=your-resend-api-key

# --- PhonePe Payment Gateway ---
PHONEPE_CLIENT_ID=your-phonepe-client-id
PHONEPE_CLIENT_SECRET=your-phonepe-client-secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_SALT_KEY=your-phonepe-salt-key
PHONEPE_SALT_INDEX=1
# Basic-auth style credentials PhonePe sends back on webhook calls —
# set these to whatever you configure in the PhonePe dashboard.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
