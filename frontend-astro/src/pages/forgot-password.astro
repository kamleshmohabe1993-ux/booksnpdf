---
import AuthLayout from '../layouts/AuthLayout.astro';
import ForgotPasswordForm from '../components/auth/ForgotPasswordForm.jsx';
import { getDictionary, resolveLang, t } from '../i18n';

const lang = resolveLang(Astro.url, Astro.cookies);
const dict = getDictionary(lang);
---

<AuthLayout title="Reset Password — Books PDF" description="Reset your Books PDF account password.">
  <h1 class="font-display text-2xl font-semibold text-[var(--ink)]">{t(dict, 'auth.forgotTitle')}</h1>
  <p class="mt-1 mb-6 text-sm text-[var(--ink-soft)]">{t(dict, 'auth.forgotSubtitle')}</p>
  <ForgotPasswordForm client:load dict={dict.auth} />
</AuthLayout>
