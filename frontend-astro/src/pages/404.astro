---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDictionary, resolveLang, t } from '../i18n';

const lang = resolveLang(Astro.url, Astro.cookies);
const dict = getDictionary(lang);
---

<BaseLayout title="Page not found" description="The page you're looking for doesn't exist on Books PDF." noindex={true}>
  <Header />
  <main id="main-content" class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-4 py-16 text-center sm:px-6">
    <div class="ticket-perforation flex flex-col items-center rounded-ticket border border-[var(--border)] bg-[var(--card)] px-10 py-12 shadow-ticket">
      <span class="font-ticket text-6xl font-bold text-[var(--accent)]">404</span>
      <h1 class="mt-4 font-display text-2xl font-semibold text-[var(--ink)]">{t(dict, 'errors.404title')}</h1>
      <p class="mt-2 max-w-sm text-sm text-[var(--ink-soft)]">{t(dict, 'errors.404body')}</p>

      <form action="/books" method="get" class="mt-6 flex w-full max-w-sm gap-2">
        <input type="search" name="search" placeholder={t(dict, 'nav.search')} class="w-full rounded-full border border-[var(--border)] bg-[var(--bg)] px-4 py-2 text-sm" />
        <button type="submit" class="shrink-0 rounded-full border border-[var(--border)] px-4 py-2 text-sm font-medium hover:bg-[var(--bg-soft)]">
          {t(dict, 'errors.404search')}
        </button>
      </form>

      <a href="/" class="mt-6 inline-flex rounded-full bg-[var(--accent)] px-6 py-2.5 text-sm font-medium text-white hover:bg-[var(--accent-dark)]">
        {t(dict, 'errors.404cta')}
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>
