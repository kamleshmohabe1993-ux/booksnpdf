# Copy this file to .env and fill in real values:
#   cp .env.example .env

# Backend API base URL.
# API_URL is read on the server (SSR pages, build-time fetches).
# PUBLIC_API_URL is the same value exposed to the browser (Astro only
# ships env vars prefixed PUBLIC_ to client-side JS) — keep both in sync.
API_URL=http://localhost:5000/api
PUBLIC_API_URL=http://localhost:5000/api

# --- Google Sign-In (SSO) ---
# Must be the SAME OAuth Client ID as the backend's GOOGLE_CLIENT_ID
# (backend/.env). This one is public/safe to expose to the browser — it's
# what renders the "Sign in with Google" button on the login page.
# Leave unset (or delete the line) to hide the button entirely.
PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
