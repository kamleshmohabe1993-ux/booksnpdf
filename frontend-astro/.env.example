# Copy this file to .env and fill in real values:
#   cp .env.example .env

# Backend API base URL.
# API_URL is read on the server (SSR pages, build-time fetches).
# PUBLIC_API_URL is the same value exposed to the browser (Astro only
# ships env vars prefixed PUBLIC_ to client-side JS) — keep both in sync.
#
# After migrating the backend to Cloudflare Workers, this is your Worker's
# URL (from `wrangler deploy` output, or your custom route), e.g.:
#   https://bookspdf-api.<your-subdomain>.workers.dev/api
# or, once you attach a custom domain to the Worker:
#   https://api.yourdomain.com/api
# Local dev default: `wrangler dev` (in backend-workers/) serves the Worker
# on http://localhost:8787 by default — NOT port 5000, which was the old
# Express backend's port. Update the host/port here if you've configured
# wrangler.toml / `wrangler dev --port` differently.
API_URL=http://localhost:8787/api
PUBLIC_API_URL=http://localhost:8787/api

# --- Google Sign-In (SSO) ---
# Must be the SAME OAuth Client ID as the backend's GOOGLE_CLIENT_ID
# (backend/.env). This one is public/safe to expose to the browser — it's
# what renders the "Sign in with Google" button on the login page.
# Leave unset (or delete the line) to hide the button entirely.
PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
