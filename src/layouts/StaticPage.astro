---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  heading: string;
  subheading?: string;
}

const { title, description, eyebrow, heading, subheading } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content">
    <div class="border-b border-[var(--border)] bg-[var(--bg-soft)]">
      <div class="mx-auto max-w-4xl px-4 py-12 text-center sm:px-6 lg:px-8">
        {eyebrow && <span class="font-ticket text-xs uppercase tracking-wide text-[var(--accent-dark)]">{eyebrow}</span>}
        <h1 class="mt-2 font-display text-3xl font-semibold text-[var(--ink)] sm:text-4xl">{heading}</h1>
        {subheading && <p class="mx-auto mt-3 max-w-xl text-sm text-[var(--ink-soft)]">{subheading}</p>}
      </div>
    </div>
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
      <slot />
    </div>
  </main>
  <Footer />
</BaseLayout>
