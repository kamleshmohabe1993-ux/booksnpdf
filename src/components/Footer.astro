---
import { getDictionary, resolveLang, t } from '../i18n';

const lang = resolveLang(Astro.url, Astro.cookies);
const dict = getDictionary(lang);
const year = new Date().getFullYear();

// TODO: replace these placeholder hrefs with your real profile URLs.
const socialLinks = [
  {
    name: 'YouTube',
    href: 'https://youtube.com/@booksnpdf',
    path: 'M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.7 15.5v-7l6.3 3.5-6.3 3.5Z',
  },
  {
    name: 'Facebook',
    href: 'https://facebook.com/booksnpdf',
    path: 'M22 12a10 10 0 1 0-11.5 9.9v-7H8v-2.9h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6v1.9H16l-.4 2.9h-2.1v7A10 10 0 0 0 22 12Z',
  },
  {
    name: 'X',
    href: 'https://x.com/booksnpdf',
    path: 'M18.9 3H22l-7.2 8.2L23 21h-6.7l-5.2-6.4L5 21H2l7.7-8.8L1.5 3h6.9l4.7 5.9L18.9 3Zm-1.2 16h1.8L7.4 5H5.5l12.2 14Z',
  },
  {
    name: 'Instagram',
    href: 'https://instagram.com/booksnpdf',
    path: null, // rendered with a dedicated multi-shape icon below
  },
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com/company/booksnpdf',
    path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3ZM9 9h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21H9Z',
  },
];
---

<footer class="mt-20 border-t border-[var(--border)] bg-[var(--bg-soft)]">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-5">
      <div class="col-span-2 sm:col-span-3 lg:col-span-2">
        <a href="/" class="flex items-center gap-2 font-display text-lg font-semibold">
          <span class="flex h-8 w-8 items-center justify-center rounded-ticket bg-[var(--accent)] font-ticket text-xs text-white">PDF</span>
          Books<span class="text-[var(--accent)]"> PDF</span>
        </a>
        <p class="mt-3 max-w-sm text-sm text-[var(--ink-soft)]">{t(dict, 'footer.tagline')}</p>
      </div>

      <div>
        <h3 class="font-ticket text-xs uppercase tracking-wide text-[var(--ink-faint)]">{t(dict, 'footer.explore')}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/books" class="text-[var(--ink-soft)] hover:text-[var(--accent)]">{t(dict, 'nav.books')}</a></li>
          <li><a href="/courses" class="text-[var(--ink-soft)] hover:text-[var(--accent)]">{t(dict, 'nav.courses')}</a></li>
          <li><a href="/books?price=free" class="text-[var(--ink-soft)] hover:text-[var(--accent)]">Free PDF books</a></li>
          <li><a href="/books?category=NCERT" class="text-[var(--ink-soft)] hover:text-[var(--accent)]">NCERT books PDF</a></li>
          <li><a href="/books?category=Hindi+Books" class="text-[var(--ink-soft)] hover:text-[var(--accent)]">Hindi books PDF</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-ticket text-xs uppercase tracking-wide text-[var(--ink-faint)]">{t(dict, 'footer.company')}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/about" class="text-[var(--ink-soft)] hover:text-[var(--accent)]">{t(dict, 'nav.about')}</a></li>
          <li><a href="/contact" class="text-[var(--ink-soft)] hover:text-[var(--accent)]">{t(dict, 'nav.contact')}</a></li>
          <li><a href="/faqs" class="text-[var(--ink-soft)] hover:text-[var(--accent)]">{t(dict, 'nav.faqs')}</a></li>
          <li><a href="/how-it-works" class="text-[var(--ink-soft)] hover:text-[var(--accent)]">{t(dict, 'footer.howItWorks')}</a></li>
          <li><a href="/delivery-info" class="text-[var(--ink-soft)] hover:text-[var(--accent)]">{t(dict, 'footer.deliveryInfo')}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-ticket text-xs uppercase tracking-wide text-[var(--ink-faint)]">{t(dict, 'footer.legal')}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/disclaimer" class="text-[var(--ink-soft)] hover:text-[var(--accent)]">{t(dict, 'footer.disclaimer')}</a></li>
          <li><a href="/policy" class="text-[var(--ink-soft)] hover:text-[var(--accent)]">{t(dict, 'footer.privacyPolicy')}</a></li>
          <li><a href="/terms-and-conditions" class="text-[var(--ink-soft)] hover:text-[var(--accent)]">{t(dict, 'footer.termsConditions')}</a></li>
          <li><a href="/refund-policy" class="text-[var(--ink-soft)] hover:text-[var(--accent)]">{t(dict, 'footer.refundPolicy')}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-[var(--border)] pt-6">
      <p class="text-xs text-[var(--ink-faint)]">{t(dict, 'footer.keywordLine')}</p>
    </div>

    <div class="mt-6 flex flex-col-reverse items-center justify-between gap-4 border-t border-[var(--border)] pt-6 sm:flex-row">
      <p class="text-xs text-[var(--ink-faint)]">&copy; {year} Books PDF. {t(dict, 'footer.rights')}</p>
      <div class="flex items-center gap-4">
        {socialLinks.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.name}
            class="flex h-8 w-8 items-center justify-center rounded-full text-[var(--ink-faint)] transition hover:bg-[var(--accent)]/10 hover:text-[var(--accent)]"
          >
            {social.name === 'Instagram' ? (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
                <circle cx="12" cy="12" r="4.5" />
                <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d={social.path} /></svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
